GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCS_ARTIFACTS_BUCKET=storybook-artifacts-xxxxxxxx   # from: terraform output artifacts_bucket
APP_DOMAIN=your-app.example.com                     # domain for GKE ManagedCertificate
DEV_DEFAULT_EMAIL=dev@storybook.local               # default user email for local dev mode
LEGACY_OWNER_EMAIL=owner@storybook.local            # user email that owns legacy unscoped sessions
